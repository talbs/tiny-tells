{
  "name": "tiny-tells",
  "version": "0.1.0",
  "description": "Give your app's status a face: six tiny animated characters in one <tiny-tell> element.",
  "keywords": [
    "web-components",
    "custom-elements",
    "status",
    "loading-indicator",
    "spinner",
    "animation",
    "canvas",
    "agent-ui"
  ],
  "homepage": "https://tinytells.dev/",
  "bugs": "https://github.com/talbs/tiny-tells/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talbs/tiny-tells.git"
  },
  "license": "MIT",
  "author": "Brian Talbot",
  "type": "module",
  "main": "./dist/tiny-tells.js",
  "unpkg": "./dist/tiny-tells.min.js",
  "jsdelivr": "./dist/tiny-tells.min.js",
  "exports": {
    ".": {
      "types": "./dist/tiny-tells.d.ts",
      "default": "./dist/tiny-tells.js"
    },
    "./play": {
      "types": "./dist/tiny-tells-play.d.ts",
      "default": "./dist/tiny-tells-play.js"
    },
    "./reserve.css": "./dist/reserve.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json",
    "./package.json": "./package.json"
  },
  "module": "./dist/tiny-tells.js",
  "types": "./dist/tiny-tells.d.ts",
  "customElements": "dist/custom-elements.json",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "og": "node tools/build.mjs && node tools/og/render.mjs",
    "icons": "node tools/favicon/render.mjs",
    "serve": "node tests/serve.mjs 4173",
    "test": "prettier --check . && eslint . && node tools/build.mjs --check && node tests/server-import.mjs && node tests/fake-dom.mjs jsdom && node tests/fake-dom.mjs happy-dom && node --test tests/public-surface.test.mjs && playwright test",
    "prepack": "node tools/build.mjs",
    "prepublishOnly": "npm test",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "microlighter": "2.2.0",
    "prettier": "^3.9.9"
  }
}
